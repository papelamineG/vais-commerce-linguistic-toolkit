# ============================================================================
# Google Cloud & Vertex AI Search for Commerce (Retail API) Configuration
# ============================================================================
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=123456789012

# Gemini API Configuration (Read dynamically by src/config.py; never hardcode in code)
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_LOCATION=global

# Vertex AI Search for Commerce (VAIS:C) Catalog & Serving Config
VAIS_LOCATION=global
VAIS_CATALOG=default_catalog
VAIS_BRANCH=0
VAIS_SERVING_CONFIG=default_search
VAIS_DEFAULT_LANGUAGE_CODE=pt-PT
